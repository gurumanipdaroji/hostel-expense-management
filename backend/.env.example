# ========================================================
# Database Configuration
# ========================================================
# For local testing without MySQL installed (Default):
DATABASE_URL=sqlite:///./hostel_management.db

# For MySQL / AWS production deployment (Uncomment and edit credentials when deploying):
# DATABASE_URL=mysql+pymysql://root:password123@localhost:3306/hostel_management

# ========================================================
# JWT Authentication Settings
# ========================================================
SECRET_KEY=supersecretjwtkey_replace_this_with_a_secure_random_key_for_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ========================================================
# Allowed CORS Origins (Comma-separated list of origins)
# ========================================================
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000
